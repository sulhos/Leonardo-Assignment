# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.mypy_cache/
.pytest_cache/
.ruff_cache/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# Environment / secrets
.env

# Weather cache: large-ish, purely regenerable from the public NASA POWER API,
# no compute cost beyond a few seconds -- not committed.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# data/scenarios (the actual pilot/dev/full scenario datasets) and outputs/*
# (result tables and figures) ARE committed: they are explicit deliverables
# (PROJECT_BRIEF.md §28) backed by real, sometimes expensive (~minutes) exhaustive
# mechanistic search, not cheaply re-downloadable like raw weather. Only the
# resumable per-run cache and ephemeral logs stay ignored.
data/scenarios/.cache/
data/ml_dataset/*
!data/ml_dataset/.gitkeep

# Trained models: baselines (naive/Ridge/Random Forest) are retrained fresh
# every notebook run (cheap, no persisted artifact needed) -- stays ignored.
# The neural network's saved checkpoint + preprocessing objects ARE committed
# (small, ~220KB total): notebook 05 loads them directly rather than
# retraining, so it can run standalone from a fresh clone without requiring
# notebook 04 to have been run first in the same session.
models/baselines/*
!models/baselines/.gitkeep

# Ephemeral run logs only.
outputs/logs/*
!outputs/logs/.gitkeep
